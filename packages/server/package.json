{
  "name": "@yapyup/server",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "db:local": "turso dev --db-file local.db",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "wrangler:dev": "wrangler dev",
    "wrangler:deploy": "bun run build:worker && wrangler deploy dist/worker.js",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "build:worker": "bun --env-file=.env.production build ./src/index.ts --target browser --outfile dist/worker.js --minify --env inline"
  },
  "dependencies": {
    "@hono/trpc-server": "^0.3.4",
    "@libsql/client": "^0.14.0",
    "@trpc/server": "^11.0.0",
    "better-auth": "^1.2.4",
    "drizzle-orm": "^0.38.4",
    "hono": "^4.7.5",
    "resend": "^4.5.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250320.0",
    "@types/bun": "^1.2.5",
    "drizzle-kit": "^0.30.5",
    "wrangler": "^3.114.2"
  }
}
