{
  "name": "yapyup",
  "private": true,
  "workspaces": [
    "packages/client",
    "packages/server"
  ],
  "scripts": {
    "dev": "bun run --filter '@yapyup/*' dev",
    "dev:client": "bun run --filter @yapyup/client dev",
    "dev:server": "bun run --filter @yapyup/server dev",
    "db:local": "bun run --filter @yapyup/server db:local",
    "db:push": "bun run --filter @yapyup/server db:push",
    "clean": "rm -rf node_modules packages/client/node_modules packages/server/node_modules bun.lock packages/client/bun.lock packages/server/bun.lock",
    "build": "bun run build:client",
    "build:client": "bun run --filter @yapyup/client build",
    "wrangler:deploy": "bun run --filter @yapyup/server wrangler:deploy",
    "dev:wrangler": "bun run build:client && wrangler dev"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
